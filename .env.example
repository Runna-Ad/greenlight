# Copia a .env.local y rellena. NUNCA subas .env.local a git.

# Conector de Google Sheets (Apps Script desplegado como aplicación web)
SHEETS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
SHEETS_SCRIPT_SECRET=la-contrasena-de-Propiedades-del-script

# Supabase — esquema `produccion`
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
# SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# HÜE Prisma › Formatos (adaptar un anuncio a N tamaños)
# Enciende la pantalla (además de NEXT_PUBLIC_PRISMA_ENABLED). En desarrollo siempre está encendida.
NEXT_PUBLIC_PRISMA_FORMATOS_ENABLED=
# Relleno con IA: "gemini" lo enciende (necesita GEMINI_API_KEY). Vacío = sólo desenfoque y color ($0).
PRISMA_FORMATOS_IA=
# SOLO servidor. Llave de la API de Gemini (aistudio.google.com/apikey). Nunca con prefijo NEXT_PUBLIC_.
GEMINI_API_KEY=
